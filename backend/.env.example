# Copy to backend/.env for local (non-Docker) runs:  cp .env.example .env
# docker-compose sets its own environment and ignores this file entirely.

# --- Database ----------------------------------------------------------------
# SQLite by default so a fresh clone runs with zero infrastructure. The models
# declare JSONB and UUID as dialect variants, so the same schema loads on either
# engine and nothing about the risk maths changes.
#
# The file is created on first startup and is gitignored. Delete it to reset.
DATABASE_URL=sqlite:///./alphariskiq.db

# Postgres is the deployment target. Uncomment this (and comment the line above)
# once you have Postgres running locally, or just use `docker compose up`.
# DATABASE_URL=postgresql+psycopg2://alpharisk:alpharisk@localhost:5432/alphariskiq

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. Without it, investment reports use the deterministic template
# fallback: every risk figure is identical, only the prose is missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where the price series, universe definitions and scenario library live. Empty
# resolves to the repository's own data/ folder. docker-compose sets /data.
DATA_ROOT=

# --- Conventions -------------------------------------------------------------
# Every one of these is republished by GET /methodology and written into the
# calculation_basis of each stored result. Change them only with a reason you can
# defend, because each one moves reported numbers.

# 252 is the US convention; the NSE universe declares 250 in
# data/universes/universes.json and that per-universe value wins.
# TRADING_DAYS_PER_YEAR=252

# 1 = sample standard deviation (unbiased), 0 = population.
# STD_DDOF=1

# Sortino's minimum acceptable return, as an ANNUAL rate. 0.0 means "any loss is
# downside" and is the most comparable convention across portfolios.
# SORTINO_MAR_ANNUAL=0.0

# Set false for the zero-drift textbook parametric VaR, V * z * sigma.
# PARAMETRIC_VAR_INCLUDES_DRIFT=true

# numpy quantile interpolation: linear | lower | higher. "lower" always returns a
# return that actually happened, which is more defensible at high confidence on
# short samples.
# HISTORICAL_VAR_QUANTILE_METHOD=linear

# Rolling window for the out-of-sample VaR backtest.
# BACKTEST_WINDOW=250
